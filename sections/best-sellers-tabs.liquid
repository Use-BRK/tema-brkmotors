{%- liquid
  assign s = section.settings
  assign section_width = s.section_width
  assign items_per_row = s.items_per_row
  assign items_per_row_mobile = s.items_per_row_mobile
  assign items_to_show = s.items_to_show
  assign column_gap = s.column_gap
  assign scroll_animation = settings.scroll_animation
  if items_per_row_mobile > 1 and items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  endif
-%}
{%- capture col_style -%}
--col-desktop: {{ items_per_row }};--col-number:{{ items_per_row_mobile }};{% if items_per_row > 3 %}--col-tablet: 3;{% else %}--col-tablet: {{ items_per_row }};{% endif %}{% if column_gap < 15 %}--col-gap: {{ column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{ column_gap }}px;{% endif %}--repeat: {{ items_to_show }}; --col-mobile: {{ items_per_row_mobile }}
{%- endcapture -%}
{%- capture css_vars -%}
--bst-bg: {{ s.background_color | default: '#f7f2f0' }};
--bst-active-color: {{ s.active_color | default: '#252525' }};
--bst-inactive-color: {{ s.inactive_color | default: 'rgba(37,37,37,0.5)' }};
--bst-active-size: {{ s.active_font_size }}px;
--bst-inactive-size: {{ s.inactive_font_size }}px;
--section-pt: {{ s.padding_top }}px; --section-pb: {{ s.padding_bottom }}px;
{%- endcapture -%}
{%- style -%}
  .best-sellers-tabs { position: relative; background-color: var(--bst-bg); padding-top: var(--section-pt); padding-bottom: var(--section-pb); }
  .best-sellers-tabs__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
  .best-sellers-tabs__tabs { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 14px; row-gap: 6px; }
  .best-sellers-tabs__tab { -webkit-appearance: none; appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
    font-family: var(--heading-font); font-weight: 600; font-style: italic; line-height: .9; letter-spacing: -0.01em;
    color: var(--bst-inactive-color); font-size: var(--bst-inactive-size);
    transition: font-size var(--duration-short,.3s) ease, color var(--duration-short,.3s) ease, opacity var(--duration-short,.3s) ease; }
  .best-sellers-tabs__tab:hover { color: var(--bst-active-color); }
  .best-sellers-tabs__tab.active { color: var(--bst-active-color); font-size: var(--bst-active-size); }
  .best-sellers-tabs__sep { font-family: var(--heading-font); font-weight: 600; font-style: italic; line-height: .9;
    color: var(--bst-active-color); font-size: var(--bst-inactive-size); user-select: none; align-self: baseline; }
  .best-sellers-tabs__viewall { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; flex: none;
    font-family: var(--heading-font); font-weight: 400; font-size: clamp(1.6rem, 1.4vw, 2.4rem); color: #6c6c6c; text-decoration: none;
    transition: color var(--duration-short,.3s) ease; }
  .best-sellers-tabs__viewall:hover { color: var(--bst-active-color); }
  .best-sellers-tabs__viewall .arrow { color: var(--bst-accent, #ff5e22); font-size: 1.3em; line-height: 1; }
  .best-sellers-tabs .tab-content { position: relative; }
  .best-sellers-tabs .collection-tab__tab-content { transform: translateY(30px); }
  .best-sellers-tabs .collection-tab__tab-content.active { opacity: 1; visibility: visible; position: relative; transform: translateY(0); pointer-events: auto; }
  @media screen and (max-width: 767.98px) {
    .best-sellers-tabs__head { flex-wrap: wrap; align-items: baseline; }
    .best-sellers-tabs__viewall { margin-left: auto; }
  }
{%- endstyle -%}
<div class="best-sellers-tabs section{% if s.padding_top < 30 %} pt-min{% endif %}{% if s.padding_bottom < 30 %} pb-min{% endif %}" style="{{ css_vars | strip | strip_newlines }}">
  <div class="{{ section_width }}">
    {%- if section.blocks.size > 0 -%}
      <tab-items data-type="horizontal">
        <div class="best-sellers-tabs__head">
          <div class="best-sellers-tabs__tabs">
            {%- for block in section.blocks -%}
              {%- liquid
                assign block_st = block.settings
                assign col = collections[block_st.collection]
                assign tab_title = block_st.collection_title | default: col.title | default: block_st.collection.title
                assign tab_url = col.url | default: block_st.link
              -%}
              <button
                type="button"
                data-block-id="{{ block.id }}"
                data-url="{{ tab_url }}"
                class="collection-tab__tab-item best-sellers-tabs__tab{% if forloop.first %} active{% endif %}"
                {{ block.shopify_attributes }}
              >{{ tab_title | default: 'Coleção' }}</button>
              {%- unless forloop.last -%}<span class="best-sellers-tabs__sep" aria-hidden="true">|</span>{%- endunless -%}
            {%- endfor -%}
          </div>
          {%- if s.show_view_all -%}
            {%- assign first_block = section.blocks.first -%}
            {%- assign first_col = collections[first_block.settings.collection] -%}
            <a class="best-sellers-tabs__viewall" href="{{ first_col.url | default: first_block.settings.link | default: '#' }}" data-viewall>
              {{ s.view_all_label | default: 'Ver tudo' }} <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
        <div class="relative tab-content">
          {%- for block in section.blocks -%}
            {%- liquid
              assign block_st = block.settings
              assign col = collections[block_st.collection]
            -%}
            <div
              class="collection-tab__tab-content absolute invisible inset-0 transition pointer-none{% if forloop.first %} active{% endif %}"
              data-block-id="{{ block.id }}"
            >
              {%- if items_per_row_mobile > 1 and items_per_row_mobile < 2 -%}<div class="free-scroll">{%- endif -%}
              <slide-section
                class="swiper"
                data-section-id="{{ section.id }}"
                data-block-id="{{ block.id }}"
                data-autoplay="false"
                data-effect="slide"
                data-loop="false"
                data-speed="800"
                data-spacing="{{ column_gap }}"
                data-mobile="{{ items_per_row_mobile }}"
                data-tablet="3"
                data-desktop="{{ items_per_row }}"
                data-free-scroll="{{ data_free_scroll }}"
                style="{{ col_style | strip | strip_newlines }}"
                data-arrow-centerimage="1"
              >
                {%- if s.show_arrow -%}{%- render 'swiper-navigation' -%}{%- endif -%}
                <div class="swiper-wrapper">
                  {%- if col.products.size > 0 -%}
                    {%- for product in col.products limit: items_to_show -%}
                      {% render 'product-item',
                        card_product: product,
                        section_id: section.id,
                        class: ' swiper-slide',
                        template_enable_action: true,
                        template_enable_product_vendor: false,
                        template_enable_rate: false,
                        template_enable_price: true,
                        template_enable_color_swatches: false,
                        template_enable_add_cart: false,
                        template_enable_product_badges: true,
                        scroll_animation: scroll_animation,
                        indexFor: forloop.index
                      %}
                    {%- endfor -%}
                  {%- else -%}
                    {%- for i in (1..items_per_row) -%}
                      {% render 'product-item',
                        section_id: section.id,
                        class: ' swiper-slide',
                        template_enable_price: true,
                        indexFor: i,
                        scroll_animation: scroll_animation
                      %}
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              </slide-section>
              {%- if items_per_row_mobile > 1 and items_per_row_mobile < 2 -%}</div>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </tab-items>
      <script>
        (function () {
          var root = document.currentScript.closest('.best-sellers-tabs');
          if (!root) return;
          var viewAll = root.querySelector('[data-viewall]');
          root.querySelectorAll('.best-sellers-tabs__tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
              if (viewAll && tab.dataset.url) viewAll.setAttribute('href', tab.dataset.url);
            });
          });
        })();
      </script>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Coleções em Abas",
  "tag": "section",
  "class": "section-best-sellers-tabs",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.all.section_width.label",
      "default": "fluid_container",
      "options": [
        { "value": "container", "label": "t:sections.all.section_width.container.label" },
        { "value": "fluid_container", "label": "t:sections.all.section_width.fluid_container.label" },
        { "value": "stretch_width", "label": "t:sections.all.section_width.stretch_width.label" },
        { "value": "full_width", "label": "t:sections.all.section_width.full_width.label" }
      ]
    },
    { "type": "color", "id": "background_color", "label": "Cor de fundo", "default": "#f7f2f0" },
    { "type": "header", "content": "Abas (títulos)" },
    { "type": "color", "id": "active_color", "label": "Cor da aba ativa", "default": "#252525" },
    { "type": "color", "id": "inactive_color", "label": "Cor das abas inativas", "default": "#929292" },
    { "type": "range", "id": "active_font_size", "min": 24, "max": 72, "step": 2, "unit": "px", "label": "Tamanho da aba ativa", "default": 48 },
    { "type": "range", "id": "inactive_font_size", "min": 16, "max": 56, "step": 2, "unit": "px", "label": "Tamanho das abas inativas", "default": 36 },
    { "type": "header", "content": "Link \"Ver tudo\"" },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostrar link \"Ver tudo\"", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Texto do link", "default": "Ver tudo" },
    { "type": "header", "content": "Produtos" },
    { "type": "range", "id": "items_to_show", "label": "t:sections.all.items.items_to_show.label", "min": 2, "max": 24, "step": 1, "default": 10 },
    { "type": "range", "id": "items_per_row", "label": "t:sections.all.items.items_per_row.label", "min": 2, "max": 6, "step": 1, "default": 5 },
    { "type": "range", "id": "column_gap", "label": "t:sections.all.items.column_gap.label", "min": 0, "max": 50, "step": 1, "default": 16, "unit": "px" },
    { "type": "checkbox", "id": "show_arrow", "label": "t:sections.all.carousel_settings.show-next-back.label", "default": true },
    { "type": "header", "content": "t:sections.all.mobile_options.label" },
    { "type": "range", "id": "items_per_row_mobile", "label": "t:sections.all.items.items_per_row.label", "min": 1, "max": 2, "step": 0.5, "default": 1.5 },
    { "type": "header", "content": "t:sections.all.section_padding.label" },
    { "type": "range", "id": "padding_top", "label": "t:sections.all.section_padding.top.label", "default": 60, "min": 0, "max": 120, "step": 2, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.all.section_padding.bottom.label", "default": 60, "min": 0, "max": 120, "step": 2, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "collection",
      "limit": 6,
      "name": "Aba de coleção",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Coleção" },
        { "type": "text", "id": "collection_title", "label": "Título da aba (opcional)", "info": "Sobrescreve o nome da coleção" },
        { "type": "url", "id": "link", "label": "Link alternativo (opcional)", "info": "Usado no \"Ver tudo\" se não houver coleção" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coleções em Abas",
      "blocks": [
        { "type": "collection", "settings": { "collection_title": "Mais Vendidos" } },
        { "type": "collection", "settings": { "collection_title": "Lançamentos" } }
      ]
    }
  ]
}
{% endschema %}
