{%- comment -%}
  BRK MOTORS — "Detalhes do produto": tabela de especificações modular.
  Modularidade por metafields (namespace custom):
   1) Se existir custom.especificacoes (rich text) -> renderiza ele (controle total).
   2) Senão, se o produto tiver QUALQUER metafield mapeado nas linhas (mf_key) ->
      MODO METAFIELD: mostra só as linhas cujo metafield está preenchido.
      (ex.: produto sem UV50 = não seta custom.protecao -> a linha some.)
   3) Senão -> mostra os valores default (boilerplate de camisa).
  Sempre pode anexar SKU e Prazo de Produção (custom.disponibilidade) no fim.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign accent = st.accent_color | default: '#fc5106'
  assign mf_full = product.metafields.custom.especificacoes
  assign variant = product.selected_or_first_available_variant
  assign sentinels = 'nao,não,off,false,none,no,0,-,—'
-%}
<div class="brk-specs" id="brk-specs-{{ section.id }}" style="--brk-accent: {{ accent }};">
  <div class="brk-wrap">
    <header class="brk-specs__head">
      {%- if st.eyebrow != blank -%}<span class="brk-specs__eyebrow">{{ st.eyebrow }}</span>{%- endif -%}
      <h2 class="brk-specs__title">{{ st.heading | default: 'Detalhes do produto' }}</h2>
    </header>

    {%- if mf_full != blank -%}
      <div class="brk-specs__card brk-specs__rte rte">{{ mf_full }}</div>
    {%- else -%}
      <div class="brk-specs__card">
        <dl class="brk-specs__grid">
          {%- for i in (1..8) -%}
            {%- liquid
              assign klabel = 's' | append: i | append: '_label'
              assign kval = 's' | append: i | append: '_value'
              assign kicon = 's' | append: i | append: '_icon'
              assign kmfk = 's' | append: i | append: '_mf'
              assign label = st[klabel]
              assign defval = st[kval]
              assign icon = st[kicon]
              assign mfk = st[kmfk]
              assign value = defval
              if mfk != blank
                assign mv = product.metafields.custom[mfk]
                if mv != blank
                  assign raw = mv.value | join: ', '
                  assign raws = raw | downcase | strip
                  if sentinels contains raws
                    assign value = ''
                  else
                    assign value = raw
                  endif
                endif
              endif
            -%}
            {%- if label != blank and value != blank -%}
              <div class="brk-specs__row">
                <dt class="brk-specs__label">
                  <span class="brk-specs__icon">{% render 'brk-icon', name: icon %}</span>
                  <span>{{ label }}</span>
                </dt>
                <dd class="brk-specs__value">{{ value }}</dd>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- if st.show_sku and variant.sku != blank -%}
            <div class="brk-specs__row">
              <dt class="brk-specs__label"><span class="brk-specs__icon">{% render 'brk-icon', name: 'medal' %}</span><span>{{ st.sku_label | default: 'Código' }}</span></dt>
              <dd class="brk-specs__value">{{ variant.sku }}</dd>
            </div>
          {%- endif -%}

          {%- if st.show_prazo -%}
            {%- assign dispo = product.metafields.custom.disponibilidade -%}
            <div class="brk-specs__row">
              <dt class="brk-specs__label"><span class="brk-specs__icon">{% render 'brk-icon', name: 'truck' %}</span><span>{{ st.prazo_label | default: 'Prazo de produção' }}</span></dt>
              <dd class="brk-specs__value">
                {%- case dispo -%}
                  {%- when blank -%}9 dias úteis
                  {%- when 0 -%}Pronta entrega
                  {%- when 1 -%}1 dia útil
                  {%- else -%}{{ dispo }} dias úteis
                {%- endcase -%}
              </dd>
            </div>
          {%- endif -%}
        </dl>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.brk-specs { --brk-accent: #fc5106; padding-block: 4.4rem; }
.brk-specs .brk-wrap { width: 100%; max-width: 118rem; margin-inline: auto; padding-inline: 3rem; }
.brk-specs__head { margin-bottom: 2.4rem; }
.brk-specs__eyebrow {
  display: block; font-family: var(--heading-font); font-weight: 400;
  font-size: 1.25rem; letter-spacing: .18em; text-transform: uppercase;
  color: var(--color-text, #4e4e4e); margin-bottom: .4rem;
}
.brk-specs__title {
  margin: 0; font-family: var(--heading-font); font-weight: 700; font-style: italic;
  text-transform: uppercase; letter-spacing: 0; line-height: .95;
  font-size: clamp(2.4rem, 4vw, 3.4rem); color: var(--color-heading, #212121);
  position: relative; padding-bottom: 1.2rem;
}
.brk-specs__title::after {
  content: ""; position: absolute; left: 0; bottom: 0;
  width: 5.2rem; height: 4px; background: var(--brk-accent);
}
.brk-specs__card {
  background: #fff; border: 1px solid var(--color-border, #ebebeb);
  border-radius: 10px; overflow: hidden;
}
.brk-specs__grid { margin: 0; display: grid; grid-template-columns: 1fr 1fr; }
.brk-specs__row {
  display: flex; align-items: center; justify-content: space-between; gap: 1.6rem;
  padding: 1.8rem 2.2rem; border-bottom: 1px solid var(--color-border, #ebebeb);
}
.brk-specs__grid .brk-specs__row:nth-child(odd) { border-right: 1px solid var(--color-border, #ebebeb); }
.brk-specs__grid .brk-specs__row:nth-child(odd):last-child { border-right: 0; }
.brk-specs__label {
  display: flex; align-items: center; gap: 1rem; margin: 0;
  font-family: var(--body-font); font-size: 1.45rem; color: var(--color-heading, #212121);
}
.brk-specs__icon { color: var(--brk-accent); line-height: 0; flex: 0 0 auto; }
.brk-specs__icon svg { width: 2rem; height: 2rem; display: block; }
.brk-specs__value {
  margin: 0; text-align: right;
  font-family: var(--body-font); font-weight: 700; font-size: 1.45rem;
  color: var(--color-text, #4e4e4e); line-height: 1.3;
}
.brk-specs__rte { padding: 2.4rem; }

@media (max-width: 768px) {
  .brk-specs { padding-block: 3rem; }
  .brk-specs .brk-wrap { padding-inline: 1.6rem; }
  .brk-specs__grid { grid-template-columns: 1fr; }
  .brk-specs__grid .brk-specs__row { border-right: 0 !important; }
  .brk-specs__row { padding: 1.5rem 1.6rem; gap: 1.2rem; }
  .brk-specs__label, .brk-specs__value { font-size: 1.35rem; }
}
{% endstylesheet %}

