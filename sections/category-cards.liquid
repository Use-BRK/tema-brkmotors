{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  assign radius = section_st.corner_radius
  assign gap = section_st.column_gap
-%}
{%- capture css_vars -%}
--cc-gap: {{ gap }}px; --cc-radius: {{ radius }}px; --cc-overlap: {{ section_st.overlap_amount }}px;
--cc-ratio: {{ section_st.card_orientation | default: '4 / 5' }};
--cc-bg: {{ section_st.background_color | default: 'transparent' }};
--section-pt: {{ section_st.padding_top }}px; --section-pb: {{ section_st.padding_bottom }}px;
{%- endcapture -%}
{%- style -%}
  .category-cards { --cc-fade: var(--cc-overlap); position: relative; z-index: 5; background: linear-gradient(180deg, color-mix(in srgb, var(--cc-bg), transparent 100%) 0%, var(--cc-bg) var(--cc-fade)); padding-top: var(--section-pt); padding-bottom: var(--section-pb); }
  .category-cards.is-overlap { margin-top: calc(var(--cc-overlap) * -1); }
  .category-cards__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--cc-gap);
  }
  .category-card {
    position: relative;
    display: block;
    aspect-ratio: var(--cc-ratio, 4 / 5);
    border-radius: var(--cc-radius);
    overflow: hidden;
    isolation: isolate;
  }
  .category-card__img { position: absolute; inset: 0; width: 100% !important; height: 100% !important; max-width: none; object-fit: cover !important; transition: transform var(--duration-long, .5s) ease; }
  .category-card:hover .category-card__img { transform: scale(1.05); }
  .category-card::after {
    content: ""; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(0,0,0,.55) 100%);
  }
  .category-card__body { position: absolute; z-index: 2; left: 0; right: 0; bottom: 28px; padding: 0 20px; text-align: center; }
  .category-card__title {
    margin: 0; color: var(--cc-label-color, #f7ddae); font-family: var(--heading-font);
    font-weight: 600; font-style: italic; text-transform: uppercase; line-height: .92;
    font-size: clamp(2.8rem, 4.4vw, 4rem); letter-spacing: -0.05em;
  }
  .category-card__cta-text {
    display: block; margin-top: 7px; font-family: var(--body-font);
    font-size: 12px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase;
    color: rgba(255,255,255,.82);
  }
  @media screen and (max-width: 1024.98px) {
    .category-cards { --cc-fade: calc(var(--cc-overlap) * 0.6); padding-bottom: 10px; }
    .category-cards.is-overlap { margin-top: calc(var(--cc-overlap) * -0.6); }
    .category-cards__grid {
      grid-auto-columns: 90%;
      gap: 8px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
    }
    .category-cards__grid::-webkit-scrollbar { display: none; }
    .category-card { scroll-snap-align: start; }
    .category-card__body { left: 20px; bottom: 18px; }
  }
{%- endstyle -%}
<div class="category-cards color-{{ color_scheme }}{% if section_st.overlap_previous %} is-overlap{% endif %}" style="{{ css_vars | strip | strip_newlines }}">
  <div class="{{ section_width }}">
    <div class="category-cards__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign card_url = b.link | default: '#'
        -%}
        <a href="{{ card_url }}" class="category-card" {{ block.shopify_attributes }} aria-label="{{ b.title | escape }}">
          {%- if b.image != blank -%}
            <img
              class="category-card__img"
              src="{{ b.image | image_url: width: 904 }}"
              srcset="{{ b.image | image_url: width: 452 }} 452w, {{ b.image | image_url: width: 904 }} 904w"
              sizes="(min-width: 1025px) 33vw, 72vw"
              width="452" height="261"
              alt="{{ b.title | escape }}"
              loading="lazy"
            >
          {%- elsif b.image_asset != blank -%}
            <img class="category-card__img" src="{{ b.image_asset | asset_url }}" width="452" height="261" alt="{{ b.title | escape }}" loading="lazy">
          {%- endif -%}
          {%- if b.title != blank -%}
            <div class="category-card__body">
              <h3 class="category-card__title"{% if b.label_color != blank %} style="--cc-label-color: {{ b.label_color }}"{% endif %}>{{ b.title }}</h3>
              {%- if b.subtitle != blank -%}<span class="category-card__cta-text">{{ b.subtitle }}</span>{%- endif -%}
            </div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Cards de Categoria",
  "tag": "section",
  "class": "section-category-cards",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "options": [
        { "value": "container", "label": "t:sections.all.section_width.container.label" },
        { "value": "fluid_container", "label": "t:sections.all.section_width.fluid_container.label" },
        { "value": "full_width", "label": "t:sections.all.section_width.full_width.label" }
      ],
      "default": "container",
      "label": "t:sections.all.section_width.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "default"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo da seção",
      "default": "#0d0d0d"
    },
    {
      "type": "checkbox",
      "id": "overlap_previous",
      "label": "Sobrepor a seção anterior (hero)",
      "default": true
    },
    {
      "type": "range",
      "id": "overlap_amount",
      "min": 0, "max": 200, "step": 5, "unit": "px",
      "label": "Quantidade de sobreposição",
      "default": 130
    },
    {
      "type": "select",
      "id": "card_orientation",
      "options": [
        { "value": "4 / 5", "label": "Vertical (retrato)" },
        { "value": "1 / 1", "label": "Quadrado" },
        { "value": "3 / 4", "label": "Vertical alto" },
        { "value": "452 / 261", "label": "Horizontal (original)" }
      ],
      "default": "4 / 5",
      "label": "Formato dos cards"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0, "max": 30, "step": 1, "unit": "px",
      "label": "Arredondamento dos cantos",
      "default": 20
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0, "max": 40, "step": 1, "unit": "px",
      "label": "Espaço entre cards",
      "default": 18
    },
    {
      "type": "header",
      "content": "t:sections.all.section_padding.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 2, "unit": "px",
      "label": "t:sections.all.section_padding.top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 2, "unit": "px",
      "label": "t:sections.all.section_padding.bottom.label",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Imagem padrão (arquivo do tema)",
          "info": "Usado quando nenhuma imagem for selecionada acima. Ex: brk-cat-esportivo.png"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Categoria"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Texto secundário",
          "default": "Confira a coleção"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Cor do título",
          "default": "#f7ddae"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cards de Categoria",
      "blocks": [
        { "type": "card", "settings": { "title": "ESPORTIVO", "subtitle": "Confira a coleção", "image_asset": "brk-cat-esportivo.jpg" } },
        { "type": "card", "settings": { "title": "ESTRADA", "subtitle": "Confira a coleção", "image_asset": "brk-cat-estrada.jpg" } },
        { "type": "card", "settings": { "title": "URBANO", "subtitle": "Confira a coleção", "image_asset": "brk-cat-urbano.jpg" } },
        { "type": "card", "settings": { "title": "CUSTOM", "subtitle": "Confira a coleção", "image_asset": "brk-cat-custom.png" } }
      ]
    }
  ]
}
{% endschema %}
