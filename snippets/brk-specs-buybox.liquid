{%- comment -%}
  BRK MOTORS — "Detalhes do produto" compacto pro buy box (abaixo do brk-trust).
  Orientado por metafields (SEM defaults): a linha só aparece se o metafield
  tiver valor real — vazio/ausente ou sentinela (nao/-/off) = linha oculta.
   - Tecido/Tecnologia/Modelagem/Manga/Proteção/Cuidados -> namespace brk.*
   - Gênero -> custom.genero
   - Código -> SKU da variante
   - Prazo -> tag prazo_imediato (Pronta entrega) / fallback custom.disponibilidade
   - custom.especificacoes (rich text) substitui a tabela inteira.
  Layout de 1 coluna pra caber na coluna do buy box.
{%- endcomment -%}
{%- liquid
  assign accent = block.settings.accent_color | default: '#fc5106'
  assign heading = block.settings.heading | default: 'Detalhes do produto'
  assign mf_full = product.metafields.custom.especificacoes
  assign variant = product.selected_or_first_available_variant
  assign sentinels = 'nao,não,off,false,none,no,0,-,—'
-%}
<div class="brk-bbspecs" style="--brk-accent: {{ accent }};" {{ block.shopify_attributes }}>
  <h3 class="brk-bbspecs__title">{{ heading }}</h3>
  {%- if mf_full != blank -%}
    <div class="brk-bbspecs__card brk-bbspecs__rte rte">{{ mf_full }}</div>
  {%- else -%}
    <dl class="brk-bbspecs__card">
      {%- assign labels = 'Tecido,Tecnologia,Modelagem,Manga,Proteção,Gênero,Cuidados' | split: ',' -%}
      {%- assign icons = 'feather,dry,ruler,shield,sun,medal,refresh' | split: ',' -%}
      {%- assign mfkeys = 'tecido,tecnologia,modelagem,manga,protecao,genero,cuidados' | split: ',' -%}
      {%- comment -%} Namespace por linha: brk.* (BRK), exceto Gênero (custom.genero).
        Sem defaults: a linha só aparece se o metafield tiver valor real
        (metafield vazio/ausente OU sentinela = linha oculta). {%- endcomment -%}
      {%- assign mfns = 'brk,brk,brk,brk,brk,custom,brk' | split: ',' -%}
      {%- for label in labels -%}
        {%- liquid
          assign idx = forloop.index0
          assign mfk = mfkeys[idx]
          assign mns = mfns[idx]
          assign mv = product.metafields[mns][mfk]
          assign value = ''
          if mv != blank
            assign raw = mv.value | join: ', '
            assign raws = raw | downcase | strip
            unless sentinels contains raws
              assign value = raw
            endunless
          endif
        -%}
        {%- if value != blank -%}
          <div class="brk-bbspecs__row">
            <dt class="brk-bbspecs__label"><span class="brk-bbspecs__icon">{% render 'brk-icon', name: icons[idx] %}</span><span>{{ label }}</span></dt>
            <dd class="brk-bbspecs__value">{{ value }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if block.settings.show_sku and variant.sku != blank -%}
        <div class="brk-bbspecs__row">
          <dt class="brk-bbspecs__label"><span class="brk-bbspecs__icon">{% render 'brk-icon', name: 'medal' %}</span><span>{{ block.settings.sku_label | default: 'Código' }}</span></dt>
          <dd class="brk-bbspecs__value">{{ variant.sku }}</dd>
        </div>
      {%- endif -%}

      {%- if block.settings.show_prazo -%}
        {%- comment -%}
          Prazo: 1) tag prazo_imediato -> Pronta entrega;
          2) senão (inclui tag prazo_producao) -> metafield custom.disponibilidade,
          com default 9 dias úteis quando vazio.
        {%- endcomment -%}
        {%- assign dispo = product.metafields.custom.disponibilidade -%}
        <div class="brk-bbspecs__row">
          <dt class="brk-bbspecs__label"><span class="brk-bbspecs__icon">{% render 'brk-icon', name: 'truck' %}</span><span>{{ block.settings.prazo_label | default: 'Prazo de produção' }}</span></dt>
          <dd class="brk-bbspecs__value">
            {%- if product.tags contains 'prazo_imediato' -%}Pronta entrega
            {%- else -%}
              {%- case dispo -%}
                {%- when blank -%}9 dias úteis
                {%- when 0 -%}Pronta entrega
                {%- when 1 -%}1 dia útil
                {%- else -%}{{ dispo }} dias úteis
              {%- endcase -%}
            {%- endif -%}
          </dd>
        </div>
      {%- endif -%}
    </dl>
  {%- endif -%}
</div>
<style>
  .brk-bbspecs { --brk-accent: #fc5106; margin-top: 2rem; }
  .brk-bbspecs__title {
    margin: 0 0 1.2rem; font-family: var(--heading-font); font-weight: 700; font-style: italic;
    text-transform: uppercase; letter-spacing: .02em; line-height: 1;
    font-size: 1.7rem; color: var(--color-heading, #212121);
    position: relative; padding-left: 1.2rem;
  }
  .brk-bbspecs__title::before {
    content: ""; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    width: 4px; height: 1.6rem; background: var(--brk-accent); border-radius: 2px;
  }
  .brk-bbspecs__card {
    margin: 0; background: #fff; border: 1px solid var(--color-border, #ebebeb);
    border-radius: 12px; overflow: hidden;
  }
  .brk-bbspecs__row {
    display: flex; align-items: center; justify-content: space-between; gap: 1.4rem;
    padding: 1.25rem 1.6rem; border-bottom: 1px solid var(--color-border, #ebebeb);
  }
  .brk-bbspecs__row:last-child { border-bottom: 0; }
  .brk-bbspecs__label {
    display: flex; align-items: center; gap: .9rem; margin: 0; min-width: 0;
    font-family: var(--body-font); font-size: 1.35rem; color: var(--color-heading, #212121);
  }
  .brk-bbspecs__icon { color: var(--brk-accent); line-height: 0; flex: 0 0 auto; }
  .brk-bbspecs__icon svg { width: 1.8rem; height: 1.8rem; display: block; }
  .brk-bbspecs__value {
    margin: 0; text-align: right; font-family: var(--body-font); font-weight: 700;
    font-size: 1.35rem; color: var(--color-text, #4e4e4e); line-height: 1.3;
  }
  .brk-bbspecs__rte { padding: 1.8rem; }
  @media (max-width: 480px) {
    .brk-bbspecs__row { padding: 1.15rem 1.3rem; gap: 1rem; }
    .brk-bbspecs__label, .brk-bbspecs__value { font-size: 1.28rem; }
  }
</style>
