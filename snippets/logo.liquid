{%- liquid
  assign shop_name = shop.name
  assign theme_st = settings
  assign logo_width = theme_st.desktop_logo_width
  assign mobile_logo_width = theme_st.mobile_logo_width
-%}
{%- style -%}
  .header__brk-logo { color: inherit; }
  .header__brk-logo svg {
    display: block;
    width: var(--header-logo-width-mobile, 80px);
    height: auto;
  }
  @media screen and (min-width: 1025px) {
    .header__brk-logo svg { width: var(--header-logo-width, 100px); }
  }
{%- endstyle -%}
{% if request.page_type == 'index' %}
  <h1 class="my-0 inline-flex align-center">
{%- endif -%}
<a
  class="logo-img header-color no-underline inline-flex align-center{% if request.page_type != 'index' %} h1 my-0{% endif %}"
  href="{{ routes.root_url }}"
  aria-label="{{ shop_name }}"
  {{ block.shopify_attributes }}
>
  <span
    class="header__brk-logo header__normal-logo inline-flex align-center"
    style="--header-logo-width: {{ logo_width }}px; --header-logo-width-mobile: {{ mobile_logo_width }}px;"
  >
    {{- 'brk-logo.svg' | inline_asset_content -}}
  </span>
</a>
{% if request.page_type == 'index' %}
  </h1>
{%- endif -%}
