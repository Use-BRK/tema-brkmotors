{%- comment -%}
  Botão flutuante (só desktop) na página de busca que gera imagem(ns) de catálogo
  com os produtos e preços da busca atual. Uso interno do time de vendas.
  Render: {% render 'search-catalog-button', terms: terms %}
{%- endcomment -%}
{%- liquid
  assign catalog_logo = ''
  if settings.logo
    assign catalog_logo = settings.logo | image_url: width: 600
  endif
-%}
<style>
  .search-catalog-btn {
    position: fixed;
    left: 24px;
    bottom: 24px;
    z-index: 50;
    display: none;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border: 0;
    border-radius: 999px;
    background: #fc5106;
    color: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
  }
  .search-catalog-btn:hover { background: #d94403; }
  .search-catalog-btn[disabled] { opacity: 0.7; cursor: progress; }
  @media (min-width: 1025px) {
    .search-catalog-btn { display: inline-flex; }
  }
  .search-catalog-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
  }
  .search-catalog-modal[hidden] { display: none; }
  .search-catalog-modal__box {
    width: min(960px, 92vw);
    max-height: 90vh;
    overflow: auto;
    padding: 24px;
    border-radius: 12px;
    background: #fff;
  }
  .search-catalog-modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  .search-catalog-modal__head h3 { margin: 0; font-size: 18px; }
  .search-catalog-modal__actions { display: flex; gap: 8px; }
  .search-catalog-modal__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .search-catalog-modal__item { display: flex; flex-direction: column; gap: 8px; }
  .search-catalog-modal__item img { width: 100%; border: 1px solid #ebebeb; border-radius: 6px; }
  .search-catalog-modal__item div { display: flex; gap: 8px; }
  .search-catalog-modal button.sc-action {
    padding: 8px 14px;
    border: 1px solid #fc5106;
    border-radius: 6px;
    background: #fff;
    color: #fc5106;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .search-catalog-modal button.sc-action--primary { background: #fc5106; color: #fff; }
</style>
<button
  type="button"
  class="search-catalog-btn"
  data-search-catalog
  data-terms="{{ terms }}"
  data-logo="{{ catalog_logo }}"
  data-shop="{{ shop.name | escape }}"
  data-domain="{{ shop.domain | escape }}"
  data-accent="#fc5106"
  data-background="#f4f4f4"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
  <span data-label>Gerar catálogo</span>
</button>
<script src="{{ 'search-catalog.js' | asset_url }}" defer></script>
